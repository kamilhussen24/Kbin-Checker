<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme. All real styling is done in Compose (ui/theme/Theme.kt). -->
    <style name="Theme.KBin" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch screen, replaced by Theme.KBin as soon as the app is ready. -->
    <style name="Theme.KBin.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.KBin</item>
    </style>
</resources>
